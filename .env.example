# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so secrets never get committed.
#
# Nothing here is needed yet: the app runs on mock data until
# lib/data/firebase-source.ts exists (see docs/FIREBASE.md).

# --- Firebase Admin SDK (server only) ---------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# These have NO "NEXT_PUBLIC_" prefix, so Next.js never sends them to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line, keeping the \n sequences, wrapped in double quotes
FIREBASE_PRIVATE_KEY=

# --- Firebase client SDK (browser) -------------------------------------------
# Only needed later for admin sign-in with Firebase Auth.
# Firebase console → Project settings → General → Your apps → Web app config.
# These are public by design; access is protected by Firebase Security Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
